NODE_ENV=development
PORT=3000
DB_HOST=localhost
DB_PORT=5432
DB_NAME=bumpie
DB_USER=bumpie_user
DB_PASSWORD=your_password_here
DB_SSL=true
AWS_REGION=ca-central-1
COGNITO_USER_POOL_ID=ca-central-1_XXXXXXXXX
COGNITO_CLIENT_ID=your_client_id
COGNITO_JWKS_URI=https://cognito-idp.ca-central-1.amazonaws.com/ca-central-1_XXXXXXXXX/.well-known/jwks.json
S3_BUCKET_NAME=bumpie-documents-prod
SES_FROM_EMAIL=noreply@bumpie.ca
ALLOWED_ORIGINS=http://localhost:8081,https://bumpie.ca
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
LOG_LEVEL=info
